---
/**
 * BaseCard Component
 * 
 * Foundation component providing consistent styling and structure for all card types.
 * This component should not be used directly - instead use specialized cards like
 * ArticleCard, ProjectCard, DecisionCard, or TalkCard for specific content types.
 * 
 * Features:
 * - Consistent hover effects and transitions
 * - Responsive padding and typography
 * - Flexible slot-based content structure
 * - Accessible link wrapper
 * 
 * @component
 * 
 * @slot badge - Optional badge/label at top (e.g., "Featured")
 * @slot meta - Metadata line (date, role, category, etc.)
 * @slot title - Card heading/title
 * @slot description - Card description or summary text
 * @slot tags - Container for tag list
 * @slot default - CTA links or additional content at bottom
 * @slot media - Optional image shown on the right (stacked on top on small screens)
 * 
 * @example
 * ```astro
 * <BaseCard href="/example" class="custom-card">
 *   <Fragment slot="meta">January 2024</Fragment>
 *   <Fragment slot="title">Card Title</Fragment>
 *   <Fragment slot="description">Card description text</Fragment>
 *   <ForwardLink text="Read more" />
 * </BaseCard>
 * ```
 */

interface Props {
  /** Target URL for the card link (required) */
  href: string;
  
  /** Additional CSS classes to apply to the card */
  class?: string;
}

const { href, class: className } = Astro.props;
const hasMedia = Astro.slots.has('media');
---

<a href={href} class:list={['base-card', className, { 'base-card--media': hasMedia }]}>
  <span class="card-body">
    <slot name="badge" />
    <span class="card-meta"><slot name="meta" /></span>
    <span class="card-title"><slot name="title" /></span>
    <span class="card-description"><slot name="description" /></span>
    <slot name="tags" />
    <slot />
  </span>
  {hasMedia && <span class="card-media"><slot name="media" /></span>}
</a>

<style>
  .base-card {
    display: block;
    position: relative;
    padding: 1.5rem 1.75rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .base-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-color: var(--color-accent);
  }

  .base-card:hover {
    border-color: var(--color-text-muted);
    background: var(--color-bg-elevated);
  }

  .card-body {
    display: block;
    min-width: 0;
  }

  .base-card--media {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    gap: 1.75rem;
    align-items: center;
  }

  .card-media {
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .card-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.3s ease;
  }

  .base-card--media:hover .card-media :global(img) {
    transform: scale(1.03);
  }

  .card-meta {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .card-title {
    display: block;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.625rem;
    line-height: 1.4;
  }

  .card-description {
    display: block;
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  @media (max-width: 640px) {
    .base-card--media {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .card-media {
      order: -1;
    }

    .base-card {
      padding: 1.25rem 1.5rem;
    }

    .card-title {
      font-size: 1rem;
    }

    .card-description {
      font-size: 0.875rem;
    }
  }
</style>
