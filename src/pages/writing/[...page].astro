---
/**
 * Writing Index Page
 *
 * Lists all published content (articles and notes) with client-side filtering
 * and pagination. Renders all items in the DOM and uses JavaScript to handle
 * filter-aware pagination via query parameters (?filter=note&page=2).
 *
 * @page
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import Pagination from '../../components/Pagination.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import PageStats from '../../components/PageStats.astro';
import { getCollection } from 'astro:content';
import { pagesConfig } from '../../pages.config';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const allContent = await getCollection('writing', ({ data }) => {
    return data.draft === false;
  });

  const sortedContent = allContent.sort((a, b) => {
    return b.data.publishDate.getTime() - a.data.publishDate.getTime();
  });

  const allCount = sortedContent.length;
  const postsCount = sortedContent.filter(item => item.data.type.includes('post')).length;
  const notesCount = sortedContent.filter(item => item.data.type.includes('note')).length;

  return [{
    params: { page: undefined },
    props: {
      content: sortedContent,
      allCount,
      postsCount,
      notesCount,
    },
  }];
};

interface Props {
  content: Awaited<ReturnType<typeof getCollection<'writing'>>>;
  allCount: number;
  postsCount: number;
  notesCount: number;
}

const { content, allCount, postsCount, notesCount } = Astro.props;
const ITEMS_PER_PAGE = 5;
const currentFilter = new URLSearchParams(Astro.url.search).get('filter') || 'all';
const currentPage = parseInt(new URLSearchParams(Astro.url.search).get('page') || '1');
const totalPages = Math.ceil(allCount / ITEMS_PER_PAGE);
---

<BaseLayout>
  <SEO
    slot="head"
    title={pagesConfig.writing.title}
    description={pagesConfig.writing.description}
    type="website"
  />

  <main class="page-container">
    <header class="page-header">
      <h1 class="page-title">{pagesConfig.writing.heading}</h1>
      <p class="page-intro">
        {pagesConfig.writing.intro}
      </p>

      <div class="filter-tabs">
        <button
          class={currentFilter === 'all' ? 'active' : ''}
          data-filter="all"
          id="filter-all"
          onclick="setFilter('all')"
        >
          All
        </button>
        <button
          class={currentFilter === 'post' ? 'active' : ''}
          data-filter="post"
          id="filter-post"
          onclick="setFilter('post')"
        >
          Articles
        </button>
        <button
          class={currentFilter === 'note' ? 'active' : ''}
          data-filter="note"
          id="filter-note"
          onclick="setFilter('note')"
        >
          Notes
        </button>
      </div>

      <PageStats text={`${allCount} items`} id="page-stats" />
    </header>

    <div id="filter-counts" style="display: none;"
      data-all-count={allCount}
      data-posts-count={postsCount}
      data-notes-count={notesCount}
    ></div>

    <div class="card-list" id="card-list">
      {content.map((item) => (
        <div class="card-item" data-type={item.data.type.join(',')}>
          <ArticleCard
            title={item.data.title}
            slug={item.id}
            description={item.data.description}
            publishDate={item.data.publishDate}
            tags={item.data.tags}
          />
        </div>
      ))}
    </div>

    {content.length === 0 && (
      <p class="empty-state">No content published yet.</p>
    )}

    <div id="pagination-container">
      <Pagination
        currentPage={currentPage}
        totalPages={totalPages}
        baseUrl="/writing"
        queryParam
      />
    </div>
  </main>

  <script>
    declare global {
      interface Window {
        setFilter: (filter: 'all' | 'post' | 'note') => void;
      }
    }

    const ITEMS_PER_PAGE = 5;
    const initialFilter = (new URLSearchParams(window.location.search).get('filter') || 'all') as 'all' | 'post' | 'note';

    function getFilteredCards(filter: string): HTMLElement[] {
      const result: HTMLElement[] = [];
      document.querySelectorAll('.card-item').forEach((card) => {
        const types = (card as HTMLElement).dataset.type || '';
        if (filter === 'all' || types.includes(filter)) {
          result.push(card as HTMLElement);
        }
      });
      return result;
    }

    function applyPage(filter: string, page: number, history: 'push' | 'replace') {
      const cards = getFilteredCards(filter);
      const totalItems = cards.length;
      const totalPages = Math.max(1, Math.ceil(totalItems / ITEMS_PER_PAGE));
      const safePage = Math.max(1, Math.min(page, totalPages));
      const start = (safePage - 1) * ITEMS_PER_PAGE;
      const end = start + ITEMS_PER_PAGE;

      document.querySelectorAll('.card-item').forEach((card) => {
        (card as HTMLElement).style.display = 'none';
      });
      cards.forEach((card, i) => {
        card.style.display = i >= start && i < end ? 'block' : 'none';
      });

      const statsElement = document.getElementById('page-stats');
      if (statsElement) {
        if (totalPages > 1) {
          statsElement.textContent = `Showing ${start + 1}\u2013${Math.min(end, totalItems)} of ${totalItems} items`;
        } else {
          statsElement.textContent = `${totalItems} item${totalItems !== 1 ? 's' : ''}`;
        }
      }

      const url = new URL(window.location.href);
      if (filter !== 'all') url.searchParams.set('filter', filter);
      else url.searchParams.delete('filter');
      if (safePage > 1) url.searchParams.set('page', String(safePage));
      else url.searchParams.delete('page');
      if (url.href !== window.location.href) {
        if (history === 'push') window.history.pushState(null, '', url.href);
        else window.history.replaceState(window.history.state, '', url.href);
      }
    }

    function updatePagination(filter: string, page: number) {
      const container = document.getElementById('pagination-container');
      if (!container) return;

      const cards = getFilteredCards(filter);
      const totalItems = cards.length;
      const totalPages = Math.max(1, Math.ceil(totalItems / ITEMS_PER_PAGE));
      const safePage = Math.max(1, Math.min(page, totalPages));

      if (totalPages <= 1) {
        container.innerHTML = '';
        return;
      }

      function getPageNumbers(current: number, total: number): (number | string)[] {
        if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
        if (current <= 3) return [1, 2, 3, 4, '...', total];
        if (current >= total - 2) return [1, '...', total - 3, total - 2, total - 1, total];
        return [1, '...', current - 1, current, current + 1, '...', total];
      }

      function pageUrl(p: number): string {
        const params = new URLSearchParams();
        if (filter !== 'all') params.set('filter', filter);
        if (p > 1) params.set('page', String(p));
        const qs = params.toString();
        return `/writing${qs ? '?' + qs : ''}`;
      }

      const pageNumbers = getPageNumbers(safePage, totalPages);
      const prevSvg = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>';
      const nextSvg = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>';

      let html = '<nav class="pagination" aria-label="Pagination">';

      if (safePage > 1) {
        html += `<a href="${pageUrl(safePage - 1)}" class="pagination-btn pagination-prev" aria-label="Previous page">${prevSvg}<span>Previous</span></a>`;
      } else {
        html += `<span class="pagination-btn pagination-prev disabled" aria-disabled="true">${prevSvg}<span>Previous</span></span>`;
      }

      html += '<div class="pagination-numbers">';
      for (const p of pageNumbers) {
        if (p === '...') {
          html += '<span class="pagination-ellipsis">...</span>';
        } else {
          const active = p === safePage ? ' active' : '';
          const ariaCurrent = p === safePage ? ' aria-current="page"' : '';
          html += `<a href="${pageUrl(p as number)}" class="pagination-number${active}"${ariaCurrent}>${p}</a>`;
        }
      }
      html += '</div>';

      if (safePage < totalPages) {
        html += `<a href="${pageUrl(safePage + 1)}" class="pagination-btn pagination-next" aria-label="Next page"><span>Next</span>${nextSvg}</a>`;
      } else {
        html += `<span class="pagination-btn pagination-next disabled" aria-disabled="true"><span>Next</span>${nextSvg}</span>`;
      }

      html += '</nav>';
      container.innerHTML = html;
    }

    type Filter = 'all' | 'post' | 'note';
    let currentFilter: Filter = initialFilter;
    let currentPage = 1;

    function readUrl(): { filter: Filter; page: number } {
      const params = new URLSearchParams(window.location.search);
      const filter = params.get('filter');
      const page = parseInt(params.get('page') || '1', 10);
      return {
        filter: filter === 'post' || filter === 'note' ? filter : 'all',
        page: Number.isFinite(page) && page > 0 ? page : 1,
      };
    }

    function render(filter: Filter, page: number, history: 'push' | 'replace') {
      currentFilter = filter;
      currentPage = page;
      updateActiveButton(filter);
      applyPage(filter, page, history);
      updatePagination(filter, page);
    }

    function setFilter(filter: Filter) {
      if (filter === currentFilter && currentPage === 1) return;
      render(filter, 1, 'push');
    }

    function updateActiveButton(filter: string) {
      document.querySelectorAll('.filter-tabs button').forEach((btn) => {
        (btn as HTMLElement).classList.toggle('active', (btn as HTMLElement).dataset.filter === filter);
      });
    }

    const isWritingIndex = () => document.getElementById('card-list') !== null;

    // astro:page-load fires on first load and after every ClientRouter navigation
    document.addEventListener('astro:page-load', () => {
      if (!isWritingIndex()) return;
      const { filter, page } = readUrl();
      render(filter, page, 'replace');
    });

    // Paginate in place instead of letting the router reload the page
    document.addEventListener('click', (e) => {
      const link = (e.target as Element).closest('#pagination-container a') as HTMLAnchorElement | null;
      if (!link || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      const page = parseInt(new URL(link.href).searchParams.get('page') || '1', 10);
      render(currentFilter, page, 'push');
      document.getElementById('card-list')?.scrollIntoView({ block: 'start' });
    }, true);

    // Our history entries use a null state, which the ClientRouter ignores
    window.addEventListener('popstate', () => {
      if (!isWritingIndex()) return;
      const { filter, page } = readUrl();
      render(filter, page, 'replace');
    });

    window.setFilter = setFilter;
  </script>

  <style>
    .page-container {
      max-width: 900px;
      margin: 0 auto;
      padding: 4rem 1.5rem;
    }

    .page-header {
      margin-bottom: 3rem;
    }

    .page-title {
      font-size: 2.5rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.2;
      margin-bottom: 1rem;
      color: var(--color-text);
    }

    .page-intro {
      font-size: 1.125rem;
      color: var(--color-text-secondary);
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }

    .filter-tabs {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }

    .filter-tabs button {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background: transparent;
      color: var(--color-text);
      font-weight: 500;
      font-size: 0.9375rem;
      text-decoration: none;
      border: 1px solid var(--color-border);
      border-radius: 6px;
      transition: border-color 0.2s ease;
      cursor: pointer;
    }

    .filter-tabs button:hover {
      border-color: var(--color-text-secondary);
    }

    .filter-tabs button.active {
      border-color: var(--color-text);
      font-weight: 600;
    }

    .card-list {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      margin-bottom: 3rem;
    }

    .card-item {
      display: block;
    }

    .empty-state {
      text-align: center;
      padding: 4rem 2rem;
      color: var(--color-text-secondary);
      font-size: 1.125rem;
    }

    .pagination {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid var(--color-border);
    }

    .pagination-btn {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--color-text);
      text-decoration: none;
      border: 1px solid var(--color-border);
      border-radius: 6px;
      transition: all 0.2s ease;
    }

    .pagination-btn:hover:not(.disabled) {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }

    .pagination-btn.disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    .pagination-numbers {
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }

    .pagination-number {
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 2.25rem;
      height: 2.25rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--color-text);
      text-decoration: none;
      border-radius: 6px;
      transition: all 0.2s ease;
    }

    .pagination-number:hover:not(.active) {
      background: var(--color-bg-secondary);
    }

    .pagination-number.active {
      background: var(--color-accent);
      color: var(--color-bg);
    }

    .pagination-ellipsis {
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 2.25rem;
      height: 2.25rem;
      color: var(--color-text-secondary);
    }

    @media (max-width: 768px) {
      .page-container {
        padding: 3rem 1rem;
      }

      .page-title {
        font-size: 2rem;
      }

      .page-intro {
        font-size: 1rem;
      }

      .pagination {
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .pagination-btn span {
        display: none;
      }

      .pagination-btn {
        padding: 0.5rem 0.75rem;
      }

      .pagination-numbers {
        order: -1;
        width: 100%;
        justify-content: center;
      }
    }
  </style>
</BaseLayout>

