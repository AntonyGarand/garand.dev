---
/**
 * BaseLayout
 *
 * Foundation layout component that provides the core HTML structure,
 * navigation, footer, and global styles for all pages. All other layouts extend
 * this base layout to ensure consistent site-wide structure.
 *
 * Features:
 * - HTML document structure
 * - Favicon and manifest configuration
 * - Theme system with dark/light mode support
 * - Prevents flash of wrong theme on page load
 * - Astro View Transitions support with theme persistence
 * - Sticky navigation header
 * - Global CSS imports (global, typography, utilities)
 * - Responsive layout structure
 *
 * Note: SEO meta tags (title, description, OG, Twitter) should be handled
 * by the SEO component in each page, not in this layout.
 *
 * @component
 *
 * @example
 * ```astro
 * ---
 * import BaseLayout from '../layouts/BaseLayout.astro';
 * import SEO from '../components/SEO.astro';
 * ---
 *
 * <BaseLayout>
 *   <SEO
 *     slot="head"
 *     title="About Me"
 *     description="Learn more about my background"
 *   />
 *   <div>Page content goes here</div>
 * </BaseLayout>
 * ```
 */

import { ClientRouter } from "astro:transitions";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";
import "../styles/global.css";
import "../styles/typography.css";
import "../styles/utilities.css";
---

<!doctype html>
<html lang={siteConfig.language} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO tags injected via slot -->
    <slot name="head" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a0a0a" />

    <ClientRouter />

    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const theme =
          stored ||
          (window.matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>

    <!-- Preserve theme during View Transitions -->
    <script is:inline>
      document.addEventListener("astro:before-swap", (e) => {
        const theme = document.documentElement.getAttribute("data-theme");
        e.newDocument.documentElement.setAttribute("data-theme", theme);
      });
    </script>

    <style>
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      main {
        flex: 1;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
      }

      #three-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: -1;
      }

      .vignette {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: -1;
        pointer-events: none;
        background: radial-gradient(
          ellipse 80% 60% at center,
          rgba(var(--color-bg-rgb), 0.7) 0%,
          rgba(var(--color-bg-rgb), 0.2) 50%,
          transparent 100%
        );
      }
    </style>
  </head>
  <body>
    <canvas id="three-bg" transition:persist></canvas>
    <div class="vignette"></div>
    <header class="site-header" transition:persist>
      <Navigation />
    </header>
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      import * as THREE from "three";

      (function () {
        // Prevent re-initialization on SPA navigation
        if ((window as any).__threeBgRenderer) {
          console.log("Already initialized, skipping");
          return;
        }

        const canvas = document.getElementById("three-bg") as HTMLCanvasElement;
        if (!canvas) {
          console.error("Canvas element not found");
          return;
        }

        // ==================== Types ====================

        type CursorType = "outline" | "mesh" | "plane" | "plain";
        type Theme = "dark" | "light";

        interface ColorData {
          hue: number;
          saturation: number;
          baseLightness: number;
        }

        interface CursorData {
          mesh: THREE.LineSegments | THREE.Mesh | THREE.Line;
          type: CursorType;
          position: THREE.Vector3;
          originalPosition: THREE.Vector3;
          velocity: THREE.Vector3;
          phase: number;
          rotationSpeed: number;
          parallaxSpeed: number;
          colorData: ColorData;
          waveDisplacement: THREE.Vector3;
          scrollWaveVelocity: number;
        }

        interface ScreenBounds {
          left: number;
          right: number;
          top: number;
          bottom: number;
        }

        const CONFIG = {
          cursors: {
            count: 500,
            outlineCount: 125,
            meshCount: 125,
            planeCount: 125,
            plainCount: 125,
            saturationRange: { min: 0.1, max: 0.3 },
            lightnessRange: {
              dark: { min: 0.3, max: 0.5 },
              light: { min: 0.15, max: 0.35 },
            },
            spawnBounds: {
              x: 14,
              y: 10,
              z: { min: -4, max: 4 },
            },
          },
          animation: {
            driftSpeed: 0.003,
            attractionForce: 0.0002,
            homeForce: 0.0008,
            rotationSpeedRange: { min: 0.1, max: 1.0 },
          },
          interaction: {
            waveStrength: 0.15,
            waveRadius: 3.0,
            waveDecay: 0.92,
          },
          parallax: {
            minSpeed: 0.001,
            maxSpeed: 0.002,
            scrollWaveStrength: 0.02,
            scrollWaveDecay: 0.95,
          },
        };

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(
          75,
          window.innerWidth / window.innerHeight,
          0.1,
          1000,
        );
        const renderer = new THREE.WebGLRenderer({
          canvas,
          alpha: true,
          antialias: true,
        });

        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        camera.position.z = 5;

        /**
         * Creates a 3D cursor geometry
         * Arrow points upward by default (+Y direction)
         */
        function create3DArrowGeometry() {
          const shape = new THREE.Shape();

          // Arrow head
          shape.moveTo(0, 0.2);
          shape.lineTo(-0.08, 0.05);
          shape.lineTo(-0.04, 0.05);

          // Arrow shaft
          shape.lineTo(-0.04, -0.15);
          shape.lineTo(0.04, -0.15);
          shape.lineTo(0.04, 0.05);

          // Complete head
          shape.lineTo(0.08, 0.05);
          shape.lineTo(0, 0.2);

          const extrudeSettings = {
            depth: 0.05,
            bevelEnabled: true,
            bevelThickness: 0.01,
            bevelSize: 0.01,
            bevelSegments: 2,
          };

          const geometry = new THREE.ExtrudeGeometry(shape, extrudeSettings);
          geometry.center();

          return geometry;
        }

        function create2DArrowOutlineGeometry() {
          const points = [];

          // Arrow head
          points.push(new THREE.Vector3(0, 0.2, 0));
          points.push(new THREE.Vector3(-0.08, 0.05, 0));
          points.push(new THREE.Vector3(-0.04, 0.05, 0));

          // Arrow shaft
          points.push(new THREE.Vector3(-0.04, -0.15, 0));
          points.push(new THREE.Vector3(0.04, -0.15, 0));
          points.push(new THREE.Vector3(0.04, 0.05, 0));

          // Complete head
          points.push(new THREE.Vector3(0.08, 0.05, 0));
          points.push(new THREE.Vector3(0, 0.2, 0));

          return new THREE.BufferGeometry().setFromPoints(points);
        }

        const arrow3DGeometry = create3DArrowGeometry();
        const arrow2DOutlineGeometry = create2DArrowOutlineGeometry();

        function createOutlineMaterial(color: THREE.Color) {
          return new THREE.LineBasicMaterial({
            color,
            transparent: true,
            opacity: 0.8,
          });
        }

        function createWireframeMaterial(color: THREE.Color) {
          return new THREE.MeshBasicMaterial({
            color,
            wireframe: true,
            transparent: true,
            opacity: 0.7,
          });
        }

        function createPlaneMaterial(color: THREE.Color) {
          return new THREE.MeshBasicMaterial({
            color,
            transparent: true,
            opacity: 0.3,
            side: THREE.DoubleSide,
          });
        }

        function createPlainMaterial(color: THREE.Color) {
          return new THREE.LineBasicMaterial({
            color,
            transparent: true,
            opacity: 0.9,
            linewidth: 2,
          });
        }

        function getCurrentTheme(): Theme {
          const theme = document.documentElement.getAttribute("data-theme");
          return (theme === "light" ? "light" : "dark") as Theme;
        }

        function generateCursorColor(theme: Theme) {
          const hue = Math.random();
          const saturation =
            CONFIG.cursors.saturationRange.min +
            Math.random() *
              (CONFIG.cursors.saturationRange.max -
                CONFIG.cursors.saturationRange.min);

          const lightnessRange =
            theme === "dark"
              ? CONFIG.cursors.lightnessRange.dark
              : CONFIG.cursors.lightnessRange.light;

          const baseLightness =
            lightnessRange.min +
            Math.random() * (lightnessRange.max - lightnessRange.min);

          const color = new THREE.Color().setHSL(
            hue,
            saturation,
            baseLightness,
          );

          return { hue, saturation, baseLightness, color };
        }

        function updateColorForTheme(
          hue: number,
          saturation: number,
          baseLightness: number,
          theme: Theme,
        ) {
          const oldRange =
            theme === "dark"
              ? CONFIG.cursors.lightnessRange.light
              : CONFIG.cursors.lightnessRange.dark;
          const newRange =
            theme === "dark"
              ? CONFIG.cursors.lightnessRange.dark
              : CONFIG.cursors.lightnessRange.light;

          const position =
            (baseLightness - oldRange.min) / (oldRange.max - oldRange.min);
          const newLightness =
            newRange.min + position * (newRange.max - newRange.min);

          return new THREE.Color().setHSL(hue, saturation, newLightness);
        }

        /**
         * Creates a cursor mesh based on type
         */
        function createCursorMesh(type: CursorType, color: THREE.Color) {
          switch (type) {
            case "outline": {
              const edgesGeometry = new THREE.EdgesGeometry(arrow3DGeometry);
              return new THREE.LineSegments(
                edgesGeometry,
                createOutlineMaterial(color),
              );
            }

            case "mesh": {
              return new THREE.Mesh(
                arrow3DGeometry,
                createWireframeMaterial(color),
              );
            }

            case "plane": {
              return new THREE.Mesh(
                arrow3DGeometry,
                createPlaneMaterial(color),
              );
            }

            case "plain": {
              return new THREE.Line(
                arrow2DOutlineGeometry,
                createPlainMaterial(color),
              );
            }
          }
        }

        function getCursorType(index: number): CursorType {
          if (index < CONFIG.cursors.outlineCount) return "outline";
          if (index < CONFIG.cursors.outlineCount + CONFIG.cursors.meshCount)
            return "mesh";
          if (
            index <
            CONFIG.cursors.outlineCount +
              CONFIG.cursors.meshCount +
              CONFIG.cursors.planeCount
          )
            return "plane";
          return "plain";
        }

        function getParallaxSpeed(z: number) {
          const zRange =
            CONFIG.cursors.spawnBounds.z.max - CONFIG.cursors.spawnBounds.z.min;
          const normalizedZ = (z - CONFIG.cursors.spawnBounds.z.min) / zRange;
          return (
            CONFIG.parallax.minSpeed +
            normalizedZ * (CONFIG.parallax.maxSpeed - CONFIG.parallax.minSpeed)
          );
        }

        const cursorsData: CursorData[] = [];

        function createCursor(index: number): CursorData {
          const theme = getCurrentTheme();
          const { hue, saturation, baseLightness, color } =
            generateCursorColor(theme);
          const type = getCursorType(index);

          const mesh = createCursorMesh(type, color);

          const z =
            CONFIG.cursors.spawnBounds.z.min +
            Math.random() *
              (CONFIG.cursors.spawnBounds.z.max -
                CONFIG.cursors.spawnBounds.z.min);

          const position = new THREE.Vector3(
            (Math.random() - 0.5) * CONFIG.cursors.spawnBounds.x,
            (Math.random() - 0.5) * CONFIG.cursors.spawnBounds.y,
            z,
          );

          const velocity = new THREE.Vector3(
            (Math.random() - 0.5) * CONFIG.animation.driftSpeed,
            (Math.random() - 0.5) * CONFIG.animation.driftSpeed,
            (Math.random() - 0.5) * CONFIG.animation.driftSpeed,
          );

          const phase = Math.random() * Math.PI * 2;
          const rotationSpeed =
            CONFIG.animation.rotationSpeedRange.min +
            Math.random() *
              (CONFIG.animation.rotationSpeedRange.max -
                CONFIG.animation.rotationSpeedRange.min);

          const parallaxSpeed = getParallaxSpeed(z);

          mesh.position.copy(position);
          scene.add(mesh);

          return {
            mesh,
            type,
            position: position.clone(),
            originalPosition: position.clone(),
            velocity,
            phase,
            rotationSpeed,
            parallaxSpeed,
            colorData: { hue, saturation, baseLightness },
            waveDisplacement: new THREE.Vector3(0, 0, 0),
            scrollWaveVelocity: 0,
          };
        }

        /**
         * Respawns a cursor at the edge when it goes out of bounds
         */
        function respawnCursor(cursor: CursorData, screenBounds: ScreenBounds) {
          const outTop = cursor.position.y > screenBounds.top;
          const outBottom = cursor.position.y < screenBounds.bottom;
          const outLeft = cursor.position.x < screenBounds.left;
          const outRight = cursor.position.x > screenBounds.right;

          if (outTop) {
            cursor.position.y = screenBounds.bottom;
            cursor.originalPosition.y = screenBounds.bottom;
          } else if (outBottom) {
            cursor.position.y = screenBounds.top;
            cursor.originalPosition.y = screenBounds.top;
          }

          if (outLeft) {
            cursor.position.x = screenBounds.right;
            cursor.originalPosition.x = screenBounds.right;
          } else if (outRight) {
            cursor.position.x = screenBounds.left;
            cursor.originalPosition.x = screenBounds.left;
          }
        }

        function initializeCursors() {
          console.log(`Creating ${CONFIG.cursors.count} cursors...`);
          for (let i = 0; i < CONFIG.cursors.count; i++) {
            cursorsData.push(createCursor(i));
          }
        }

        initializeCursors();

        function updateThemeColors() {
          const theme = getCurrentTheme();
          // console.log(`Theme changed to ${theme}, updating colors...`);

          cursorsData.forEach((cursor) => {
            const newColor = updateColorForTheme(
              cursor.colorData.hue,
              cursor.colorData.saturation,
              cursor.colorData.baseLightness,
              theme,
            );

            if (
              cursor.mesh.material instanceof THREE.LineBasicMaterial ||
              cursor.mesh.material instanceof THREE.MeshBasicMaterial
            ) {
              cursor.mesh.material.color.copy(newColor);
            }
          });
        }

        const observer = new MutationObserver((mutations) => {
          mutations.forEach((mutation) => {
            if (mutation.attributeName === "data-theme") {
              updateThemeColors();
            }
          });
        });

        observer.observe(document.documentElement, { attributes: true });

        let mouseX = 0;
        let mouseY = 0;
        let prevMouseX = 0;
        let prevMouseY = 0;
        let mouseVelocity = 0;
        let scrollY = 0;
        let prevScrollY = 0;
        let scrollVelocity = 0;

        function updateMousePosition(clientX: number, clientY: number) {
          prevMouseX = mouseX;
          prevMouseY = mouseY;
          mouseX = (clientX / window.innerWidth) * 2 - 1;
          mouseY = -(clientY / window.innerHeight) * 2 + 1;

          const dx = mouseX - prevMouseX;
          const dy = mouseY - prevMouseY;
          mouseVelocity = Math.sqrt(dx * dx + dy * dy);
        }

        function updateScrollPosition() {
          prevScrollY = scrollY;
          scrollY = window.scrollY || window.pageYOffset;
          scrollVelocity = Math.abs(scrollY - prevScrollY);
        }

        document.addEventListener("mousemove", (event) => {
          updateMousePosition(event.clientX, event.clientY);
        });

        document.addEventListener("touchmove", (event) => {
          const touch = event.touches[0];
          if (touch) {
            updateMousePosition(touch.clientX, touch.clientY);
          }
        });

        window.addEventListener("scroll", updateScrollPosition);
        updateScrollPosition();


        /**
         * Applies wave displacement from mouse movement
         * Accounts for parallax offset to calculate distance from rendered position
         */
        function applyMouseWave(
          targetX: number,
          targetY: number,
          mouseVel: number,
          currentScrollY: number,
        ) {
          if (mouseVel < 0.001) return;

          cursorsData.forEach((cursor) => {
            // Calculate where cursor is actually rendered after parallax
            const parallaxOffset = currentScrollY * cursor.parallaxSpeed;
            const renderedY = cursor.position.y + parallaxOffset;

            // Calculate distance from mouse to rendered position
            const dx = targetX - cursor.position.x;
            const dy = targetY - renderedY;
            const distance = Math.sqrt(dx * dx + dy * dy);

            if (distance < CONFIG.interaction.waveRadius) {
              const force =
                CONFIG.interaction.waveStrength *
                mouseVel *
                (1 - distance / CONFIG.interaction.waveRadius);

              const angle = Math.atan2(dy, dx);
              cursor.waveDisplacement.x -= Math.cos(angle) * force;
              cursor.waveDisplacement.y -= Math.sin(angle) * force;
            }
          });
        }

        /**
         * Applies scroll wave effect (rebound)
         */
        function applyScrollWave(scrollVel: number) {
          if (scrollVel < 0.1) return;

          const waveStrength =
            CONFIG.parallax.scrollWaveStrength * Math.min(scrollVel / 10, 1);

          cursorsData.forEach((cursor) => {
            cursor.scrollWaveVelocity -=
              waveStrength * cursor.parallaxSpeed * 10;
          });
        }

        // Animation Loop

        const startTime = performance.now();
        let lastFrameTime = startTime;

        function animate() {
          requestAnimationFrame(animate);

          const currentTime = performance.now();
          const deltaTime = (currentTime - lastFrameTime) * 0.001;
          lastFrameTime = currentTime;
          const elapsed = (currentTime - startTime) * 0.001;

          // Calculate screen bounds in world space
          const aspect = window.innerWidth / window.innerHeight;
          const vFov = (camera.fov * Math.PI) / 180;
          const height = 2 * Math.tan(vFov / 2) * Math.abs(camera.position.z);
          const width = height * aspect;

          const screenBounds = {
            left: -width / 2 - 1,
            right: width / 2 + 1,
            top: height / 2 + 1,
            bottom: -height / 2 - 1,
          };

          const targetX = mouseX * (width / 2);
          const targetY = mouseY * (height / 2);
          const targetZ = 0;

          applyMouseWave(targetX, targetY, mouseVelocity, scrollY);
          applyScrollWave(scrollVelocity);

          cursorsData.forEach((cursor) => {
            cursor.position.x +=
              cursor.velocity.x +
              Math.sin(elapsed * 0.5 + cursor.phase) * 0.003;
            cursor.position.y +=
              cursor.velocity.y +
              Math.cos(elapsed * 0.5 + cursor.phase) * 0.003;
            cursor.position.z += cursor.velocity.z;

            // Keep Z bounded
            if (cursor.position.z > CONFIG.cursors.spawnBounds.z.max) {
              cursor.position.z = CONFIG.cursors.spawnBounds.z.max;
              cursor.velocity.z *= -0.5;
            }
            if (cursor.position.z < CONFIG.cursors.spawnBounds.z.min) {
              cursor.position.z = CONFIG.cursors.spawnBounds.z.min;
              cursor.velocity.z *= -0.5;
            }

            // Gentle attraction to mouse (in current viewport)
            const dx = targetX - cursor.position.x;
            const dy = targetY - cursor.position.y;
            const dz = targetZ - cursor.position.z;
            const dist = Math.sqrt(dx * dx + dy * dy + dz * dz);

            if (dist > 0.5) {
              cursor.position.x += dx * CONFIG.animation.attractionForce;
              cursor.position.y += dy * CONFIG.animation.attractionForce;
              cursor.position.z += dz * CONFIG.animation.attractionForce;
            }

            // Drift back to original position
            const homeDx = cursor.originalPosition.x - cursor.position.x;
            const homeDy = cursor.originalPosition.y - cursor.position.y;
            const homeDz = cursor.originalPosition.z - cursor.position.z;

            cursor.position.x += homeDx * CONFIG.animation.homeForce;
            cursor.position.y += homeDy * CONFIG.animation.homeForce;
            cursor.position.z += homeDz * CONFIG.animation.homeForce;

            // Apply wave displacement
            cursor.position.x += cursor.waveDisplacement.x;
            cursor.position.y += cursor.waveDisplacement.y;
            cursor.waveDisplacement.multiplyScalar(
              CONFIG.interaction.waveDecay,
            );

            // Apply scroll wave velocity
            cursor.position.y += cursor.scrollWaveVelocity;
            cursor.scrollWaveVelocity *= CONFIG.parallax.scrollWaveDecay;

            // Apply parallax offset (reversed: scroll down = move up)
            const parallaxOffset = scrollY * cursor.parallaxSpeed;
            const finalY = cursor.position.y + parallaxOffset;

            // Check if cursor is out of bounds and respawn
            if (
              finalY > screenBounds.top ||
              finalY < screenBounds.bottom ||
              cursor.position.x < screenBounds.left ||
              cursor.position.x > screenBounds.right
            ) {
              respawnCursor(cursor, screenBounds);
            }

            // Update mesh position
            cursor.mesh.position.set(
              cursor.position.x,
              finalY,
              cursor.position.z,
            );

            // Calculate rotation direction accounting for parallax offset
            const rotationDx = targetX - cursor.position.x;
            const rotationDy = targetY - finalY;
            const rotationDz = targetZ - cursor.position.z;

            const direction = new THREE.Vector3(
              rotationDx,
              rotationDy,
              rotationDz,
            ).normalize();

            const targetQuaternion = new THREE.Quaternion().setFromUnitVectors(
              new THREE.Vector3(0, 1, 0),
              direction,
            );

            const dot = cursor.mesh.quaternion.dot(targetQuaternion);
            const angle = 2 * Math.acos(Math.min(Math.abs(dot), 1));
            const maxRotation =
              ((2 * Math.PI) / cursor.rotationSpeed) * deltaTime;
            const slerpFactor = Math.min(maxRotation / angle, 1);

            cursor.mesh.quaternion.slerp(targetQuaternion, slerpFactor);
          });

          // Decay velocities
          mouseVelocity *= 0.9;
          scrollVelocity *= 0.9;

          renderer.render(scene, camera);
        }

        animate();

        window.addEventListener("resize", () => {
          camera.aspect = window.innerWidth / window.innerHeight;
          camera.updateProjectionMatrix();
          renderer.setSize(window.innerWidth, window.innerHeight);
        });

        (window as any).__threeBgScene = scene;
        (window as any).__threeBgCamera = camera;
        (window as any).__threeBgRenderer = renderer;
        (window as any).__threeBgCursors = cursorsData;

        // console.log("Three.js background initialized successfully");
      })();
    </script>
  </body>
</html>
